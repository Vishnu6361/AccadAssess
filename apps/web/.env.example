# ==============================================================================
# AcadAssess Web Frontend (apps/web) Environment Configuration Template
# Hosted on: Vercel (or static hosting)
# NOTE: All variables prefixed with VITE_ are bundled into public client assets.
# NEVER put private credentials, database passwords or service-role keys here.
# ==============================================================================

# Supabase Public Client Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Note: Both VITE_SUPABASE_PUBLISHABLE_KEY and VITE_SUPABASE_ANON_KEY are supported
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Backend Trusted API URL (Express backend endpoint, e.g. on Render)
VITE_API_BASE_URL=https://acadassess-api.onrender.com/api/v1

# Python Document Processor URL (Optional, for health monitoring dashboard)
VITE_PROCESSOR_URL=https://acadassess-processor.onrender.com

