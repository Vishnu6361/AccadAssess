# ==============================================================================
# AcadAssess Node.js API (apps/api) Environment Configuration Template
# Hosted on: Render (Web Service)
# CRITICAL: Keep this server-side only. Never expose to client bundles.
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=production

# Supabase Server Configuration (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# CORS Configuration: Set to your exact production Vercel frontend URL
# Supports: exact origin, comma-separated list, trailing slashes, or CORS_ORIGINS / FRONTEND_URL
CORS_ORIGIN=https://acad-assess.vercel.app
FRONTEND_URL=https://acad-assess.vercel.app

# Storage Buckets (Pre-configured in Supabase Storage)
STORAGE_BUCKET_ASSIGNMENTS=submissions-private
STORAGE_BUCKET_SUBMISSIONS=submissions-private

# Python Document Processor Integration (Optional)
PROCESSOR_SERVICE_URL=https://acadassess-processor.onrender.com
PROCESSOR_BASE_URL=https://acadassess-processor.onrender.com
# Internal shared authentication secret (must match PROCESSOR_SHARED_SECRET / SHARED_SECRET in services/processor)
PROCESSOR_SHARED_SECRET=your-shared-internal-secret

