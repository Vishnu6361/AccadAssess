{
  "name": "smartfa",
  "version": "1.0.0",
  "private": true,
  "description": "Institutional Formative Assessment, Evaluation and Internal Answer Similarity Review System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/contracts && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api"
  },
  "keywords": [
    "formative-assessment",
    "rubrics",
    "similarity-detection",
    "mca-major-project"
  ],
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.4"
  },
  "author": "SmartFA Team",
  "license": "UNLICENSED"
}
