# ==============================================================================
# AcadAssess Monorepo Environment Configuration Template
# CRITICAL SECURITY RULE:
# Never commit real credentials, service-role keys, database passwords, or private tokens.
# Use this template for local setup and cloud deployment configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Application (apps/web) - PUBLIC CLIENT (e.g. Vercel)
# NOTE: VITE_ variables are bundled into client-side JS assets visible in browser.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_API_BASE_URL=https://acadassess-api.onrender.com/api/v1
VITE_PROCESSOR_URL=https://acadassess-processor.onrender.com

# ------------------------------------------------------------------------------
# 2. Node.js Trusted API (apps/api) - SERVER-ONLY (e.g. Render)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# CORS Configuration: Set to your exact production Vercel frontend URL
CORS_ORIGIN=https://acad-assess.vercel.app
FRONTEND_URL=https://acad-assess.vercel.app
STORAGE_BUCKET_ASSIGNMENTS=submissions-private
STORAGE_BUCKET_SUBMISSIONS=submissions-private
PROCESSOR_SERVICE_URL=https://acadassess-processor.onrender.com
PROCESSOR_BASE_URL=https://acadassess-processor.onrender.com
PROCESSOR_SHARED_SECRET=your-shared-internal-secret

# ------------------------------------------------------------------------------
# 3. Python Processing Worker (services/processor) - WORKER-ONLY (e.g. Render)
# ------------------------------------------------------------------------------
PORT=8000
PROCESSOR_ENV=production
HTR_PROVIDER=mock
HTR_MODEL_ID=trocr-base-handwritten
PROCESSOR_SHARED_SECRET=your-shared-internal-secret
SHARED_SECRET=your-shared-internal-secret

