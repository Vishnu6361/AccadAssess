# ==============================================================================
# SmartFA Environment Configuration Template
# CRITICAL SECURITY RULE:
# Never commit real credentials, service-role keys, database passwords, or processor secrets.
# Keep this file populated with empty placeholders and guidance only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Application (apps/web) - PUBLIC CLIENT CONFIGURATION
# Notice: Values prefixed with VITE_ are bundled into client-side assets and
# visible to any browser user. NEVER put service-role keys or passwords here.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 2. Node.js Trusted API (apps/api) - SERVER-ONLY CONFIGURATION
# Kept strictly server-side. Used for verifying JWTs, executing audited
# transactions, and coordinating trusted operations.
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
JWT_ISSUER=
PROCESSOR_BASE_URL=http://localhost:8000
PROCESSOR_SHARED_SECRET=

# ------------------------------------------------------------------------------
# 3. Python Processing Worker (services/processor) - WORKER-ONLY CONFIGURATION
# Kept strictly worker-side. Used for PDF rendering, HTR extraction, and
# internal pairwise answer similarity computation.
# ------------------------------------------------------------------------------
PROCESSOR_PORT=8000
PROCESSOR_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
HTR_PROVIDER=mock
HTR_MODEL_ID=trocr-base-handwritten
