# ==============================================================================
# AcadAssess Python Document Processor (services/processor) Environment Template
# Hosted on: Render (Web Service or Background Worker)
# ==============================================================================

# Server Runtime
PORT=8000
PROCESSOR_ENV=production

# Supabase Server Configuration (Optional for direct storage operations)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Processing Configuration & Authentication
HTR_PROVIDER=mock
HTR_MODEL_ID=trocr-base-handwritten
# Shared internal secret for backend-to-worker authentication (must match PROCESSOR_SHARED_SECRET in apps/api)
PROCESSOR_SHARED_SECRET=your-shared-internal-secret
SHARED_SECRET=your-shared-internal-secret

